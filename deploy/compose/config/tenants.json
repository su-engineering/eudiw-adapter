{
  "tenants": [
    {
      "id": "demo-city",
      "verifier": {
        "pkcs11": {
          "library": "/usr/lib/softhsm/libsofthsm2.so",
          "key_label": "verifier",
          "pin_file": "/hsm/pin"
        },
        "certificate_chain_file": "/hsm/verifier-hsm.pem"
      },
      "wallet_invocation": "openid4vp://",
      "oidc_provider": {
        "signing_key_file": "/keys/oidc-id-token-key.pem",
        "subject_key_file": "/keys/oidc-subject-key"
      },
      "clients": [
        {
          "client_id": "demo-portal",
          "policies": ["age-over-18", "age-over-18-mdoc", "age-over-18-payment"],
          "completion_uri": "http://localhost:8080/demo-complete",
          "dc_api_origins": ["http://localhost:3005", "http://localhost:3006"],
          "webhook": {
            "url": "http://host.docker.internal:3000/webhooks/eudiw",
            "secret_file": "/keys/webhook-secret"
          }
        },
        {
          "client_id": "keycloak-broker",
          "policies": ["pid-login"],
          "oidc": {
            "client_secret_file": "/keys/oidc-broker-secret",
            "redirect_uris": ["http://localhost:8081/realms/shop/broker/eudi-wallet/endpoint"],
            "policy_id": "pid-login",
            "subject_claims": ["issuing_country", "personal_administrative_number"],
            "id_token_claims": { "given_name": "given_name", "family_name": "family_name" }
          }
        },
        {
          "client_id": "nextcloud",
          "policies": ["pid-login"],
          "oidc": {
            "client_secret_file": "/keys/oidc-nextcloud-secret",
            "redirect_uris": [
              "http://nextcloud/index.php/apps/user_oidc/code",
              "http://nextcloud/apps/user_oidc/code"
            ],
            "policy_id": "pid-login",
            "subject_claims": ["issuing_country", "personal_administrative_number"],
            "id_token_claims": { "given_name": "given_name", "family_name": "family_name" }
          }
        }
      ],
      "policies": [
        {
          "id": "pid-login",
          "dcql": {
            "credentials": [
              {
                "id": "pid",
                "format": "dc+sd-jwt",
                "meta": { "vct_values": ["https://credentials.demo.example/pid"] },
                "claims": [
                  { "path": ["issuing_country"] },
                  { "path": ["personal_administrative_number"] },
                  { "path": ["given_name"] },
                  { "path": ["family_name"] }
                ]
              }
            ]
          },
          "output": {
            "issuing_country": { "credential": "pid", "path": ["issuing_country"] },
            "personal_administrative_number": { "credential": "pid", "path": ["personal_administrative_number"] },
            "given_name": { "credential": "pid", "path": ["given_name"] },
            "family_name": { "credential": "pid", "path": ["family_name"] }
          },
          "trusted_lists": [
            {
              "identifier": "https://lists.demo.example/pid-providers.jwt",
              "location": "/keys/pid-list.jwt",
              "format": "lote_json",
              "signer_certificates_file": "/keys/list-signer.pem",
              "issuance_service_types": ["http://uri.etsi.org/19602/SvcType/PID/Issuance"]
            }
          ],
          "allowed_issuers": ["https://issuer.demo.example"],
          "status_policy": "reject_known_invalid",
          "session_ttl_seconds": 300,
          "result_ttl_seconds": 300
        },
        {
          "id": "age-over-18",
          "dcql": {
            "credentials": [
              {
                "id": "age",
                "format": "dc+sd-jwt",
                "meta": { "vct_values": ["https://credentials.demo.example/age"] },
                "claims": [ { "path": ["age_over_18"] } ]
              }
            ]
          },
          "output": {
            "age_over_18": { "credential": "age", "path": ["age_over_18"] }
          },
          "trusted_lists": [
            {
              "identifier": "https://lists.demo.example/pid-providers.jwt",
              "location": "/keys/pid-list.jwt",
              "format": "lote_json",
              "signer_certificates_file": "/keys/list-signer.pem",
              "issuance_service_types": ["http://uri.etsi.org/19602/SvcType/PID/Issuance"]
            }
          ],
          "allowed_issuers": ["https://issuer.demo.example"],
          "status_policy": "reject_known_invalid",
          "session_ttl_seconds": 300,
          "result_ttl_seconds": 600
        },
        {
          "id": "age-over-18-payment",
          "dcql": {
            "credentials": [
              {
                "id": "age",
                "format": "dc+sd-jwt",
                "meta": { "vct_values": ["https://credentials.demo.example/age"] },
                "claims": [ { "path": ["age_over_18"] } ]
              }
            ]
          },
          "output": {
            "age_over_18": { "credential": "age", "path": ["age_over_18"] }
          },
          "trusted_lists": [
            {
              "identifier": "https://lists.demo.example/pid-providers.jwt",
              "location": "/keys/pid-list.jwt",
              "format": "lote_json",
              "signer_certificates_file": "/keys/list-signer.pem",
              "issuance_service_types": ["http://uri.etsi.org/19602/SvcType/PID/Issuance"]
            }
          ],
          "allowed_issuers": ["https://issuer.demo.example"],
          "status_policy": "reject_known_invalid",
          "transaction_data_types": ["payment_card"],
          "session_ttl_seconds": 300,
          "result_ttl_seconds": 600
        },
        {
          "id": "age-over-18-mdoc",
          "dcql": {
            "credentials": [
              {
                "id": "pid",
                "format": "mso_mdoc",
                "meta": { "doctype_value": "eu.europa.ec.eudi.pid.1" },
                "claims": [ { "path": ["eu.europa.ec.eudi.pid.1", "age_over_18"], "intent_to_retain": false } ]
              }
            ]
          },
          "output": {
            "age_over_18": { "credential": "pid", "path": ["eu.europa.ec.eudi.pid.1", "age_over_18"] }
          },
          "trusted_lists": [
            {
              "identifier": "https://lists.demo.example/pid-providers.jwt",
              "location": "/keys/pid-list.jwt",
              "format": "lote_json",
              "signer_certificates_file": "/keys/list-signer.pem",
              "issuance_service_types": ["http://uri.etsi.org/19602/SvcType/PID/Issuance"]
            }
          ],
          "allowed_issuers": ["Demo Issuer"],
          "status_policy": "reject_known_invalid",
          "session_ttl_seconds": 300,
          "result_ttl_seconds": 600
        }
      ]
    }
  ]
}
