<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.su-engineering</groupId>
  <artifactId>eudiw-adapter-parent</artifactId>
  <version>0.3.0</version>
  <packaging>pom</packaging>

  <name>eudiw-adapter</name>
  <description>Self-hostable adapter for accepting EUDI and compatible wallet credentials</description>
  <url>https://github.com/su-engineering/eudiw-adapter</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <organization>su-engineering</organization>
      <organizationUrl>https://github.com/su-engineering</organizationUrl>
    </developer>
  </developers>

  <modules>
    <module>adapter-core</module>
    <module>adapter-crypto-brainpool</module>
    <module>adapter-kms-aws</module>
    <module>adapter-verifier-service</module>
  </modules>

  <properties>
    <assertj.version>3.27.7</assertj.version>
    <authlete-sd-jwt.version>1.11</authlete-sd-jwt.version>
    <authlete-cbor.version>1.21</authlete-cbor.version>
    <bouncycastle.version>1.87</bouncycastle.version>
    <jdk.version>21</jdk.version>
    <junit.version>6.1.3</junit.version>
    <nimbus-jose-jwt.version>10.10</nimbus-jose-jwt.version>
    <awssdk.version>2.46.7</awssdk.version>
    <quarkus.version>3.40.1.2</quarkus.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.su-engineering</groupId>
        <artifactId>adapter-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.su-engineering</groupId>
        <artifactId>adapter-crypto-brainpool</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.su-engineering</groupId>
        <artifactId>adapter-kms-aws</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.nimbusds</groupId>
        <artifactId>nimbus-jose-jwt</artifactId>
        <version>${nimbus-jose-jwt.version}</version>
      </dependency>
      <dependency>
        <!-- Independent SD-JWT implementation, test scope only (ADR-005) -->
        <groupId>com.authlete</groupId>
        <artifactId>sd-jwt</artifactId>
        <version>${authlete-sd-jwt.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <!-- Independent CBOR and COSE implementation, test scope only (ADR-012) -->
        <groupId>com.authlete</groupId>
        <artifactId>cbor</artifactId>
        <version>${authlete-cbor.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <!-- Runtime only in adapter-crypto-brainpool, which is opt-in (ADR-012) -->
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <!-- Test PKI generation only -->
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcpkix-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <release>${jdk.version}</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.7.0</version>
        <executions>
          <execution>
            <id>enforce-boundaries</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <bannedDependencies>
                  <excludes>
                    <!-- ADR-001: no Keycloak code in this project -->
                    <exclude>org.keycloak</exclude>
                  </excludes>
                </bannedDependencies>
                <dependencyConvergence/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <java>
            <palantirJavaFormat/>
            <importOrder/>
            <removeUnusedImports/>
            <formatAnnotations/>
          </java>
          <pom>
            <sortPom>
              <expandEmptyElements>false</expandEmptyElements>
            </sortPom>
          </pom>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
